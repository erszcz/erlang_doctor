{erl_opts, [debug_info]}.

%% esqlite is a soft dependency: only trdb_sqlite needs it, and it is loaded
%% lazily when that backend is first used. Declaring it here would force a
%% native dependency on every user of erlang_doctor, so it is a test-profile
%% dependency instead; applications that enable the SQLite backend add it to
%% their own deps.
{deps, []}.

{xref_checks, [undefined_function_calls]}.

{profiles, [{test, [{deps, [{esqlite, "0.10.0"}]}]}]}.

{project_plugins, [rebar3_ex_doc]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [{extras, ["README.md"]},
          {main, "README.md"},
          {homepage_url, "https://github.com/chrzaszcz/erlang_doctor"},
          {source_url, "https://github.com/chrzaszcz/erlang_doctor"},
          {api_reference, false}
         ]}.
